PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Set a dedicated project API key on the server only. Never put it in VITE_*.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe
ANALYSIS_MODEL=gpt-4.1
# Required in production. Configure privately in the host secret manager.
APP_PASSWORD=
APP_SESSION_SECRET=
# Explicit opt-in to public use, including paid AI calls. Default remains protected.
ALLOW_PUBLIC_ACCESS=false
# Set only to the verified number of trusted reverse proxies; do not guess.
TRUST_PROXY_HOPS=
